{
  "name": "PitchGen",
  "version": 1,
  "colour": {
    "teal": {
      "950": "#04171c",
      "900": "#072a32",
      "800": "#0b3c47",
      "700": "#0f5563",
      "600": "#13707f",
      "500": "#178e9e",
      "400": "#2fb3c2",
      "300": "#6fd0da",
      "200": "#b4e6eb",
      "100": "#e3f5f7"
    },
    "semantic": {
      "ink": "{teal.950}",
      "ink-2": "#082129",
      "ink-3": "#0d303a",
      "paper": "#eef6f7",
      "mute": "#8fa9af",
      "line": "rgba(238,246,247,0.12)",
      "accent": "{teal.400}",
      "accent-strong": "{teal.500}",
      "ok": "#4cbf8a",
      "warn": "#e0a458",
      "danger": "#e2695e"
    },
    "contrast": {
      "paper on ink": "15.9:1",
      "accent on ink": "8.4:1",
      "mute on ink": "6.2:1",
      "ink on accent": "8.4:1"
    }
  },
  "type": {
    "display": {
      "family": "Cormorant Garamond",
      "weights": [
        400,
        500
      ],
      "italic": true,
      "use": "Titles, loglines, pull quotes"
    },
    "body": {
      "family": "Montserrat Variable",
      "weights": [
        400,
        500,
        600
      ],
      "use": "UI, body copy, labels"
    },
    "eyebrow": {
      "size": "0.68rem",
      "tracking": "0.2em",
      "transform": "uppercase",
      "weight": 600
    }
  },
  "radius": {
    "control": "8px",
    "card": "10px",
    "pill": "999px",
    "mark": "16px"
  },
  "space": {
    "section-y": "5rem",
    "gutter": [
      "1.25rem",
      "3rem",
      "5rem"
    ]
  },
  "logo": {
    "mark": "The slate in the frame: a clapperboard inside the corner brackets of a cinema frame. One colour, no tile, no gradient. Brackets 2.2 stroke, clapper stripes 2",
    "wordmark": "PitchGen, Montserrat 600, same colour as the mark",
    "on dark": "paper #eef6f7",
    "on light": "ink #04171c",
    "app icon": "paper mark on an ink #04171c rounded square (favicon, apple-icon)"
  }
}
