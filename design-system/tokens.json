{
  "name": "PitchGen",
  "version": 2,
  "colour": {
    "teal": {
      "950": "#04171c",
      "900": "#072a32",
      "800": "#0b3c47",
      "700": "#0f5563",
      "600": "#13707f",
      "500": "#178e9e",
      "400": "#2fb3c2",
      "300": "#6fd0da",
      "200": "#b4e6eb",
      "100": "#e3f5f7",
      "50": "#f2fafb"
    },
    "semantic": {
      "bg": "#ffffff",
      "surface": "#f5f8f9",
      "surface-2": "#e9f0f2",
      "fg": "#0b1215",
      "fg-2": "#2a3539",
      "mute": "#5b6b70",
      "line": "rgba(11,18,21,0.12)",
      "accent": "{teal.600}",
      "accent-strong": "{teal.700}",
      "accent-soft": "{teal.100}",
      "ok": "#1f8a5b",
      "warn": "#a85f0a",
      "danger": "#c2362b"
    },
    "contrast": {
      "fg on bg": "19.2:1",
      "fg-2 on bg": "12.1:1",
      "mute on bg": "6.3:1",
      "accent on bg": "5.6:1",
      "white on accent-strong": "7.4:1"
    }
  },
  "type": {
    "display": { "family": "Sora Variable", "weight": 700, "tracking": "-0.02em", "use": "All headings and the wordmark" },
    "body": { "family": "Inter Variable", "weights": [400, 500, 600], "size": "16px", "lineHeight": 1.55, "use": "Body copy, labels, buttons" },
    "eyebrow": { "size": "0.72rem", "tracking": "0.14em", "transform": "uppercase", "weight": 700, "colour": "accent" }
  },
  "radius": { "control": "10px", "card": "12px", "pill": "999px" },
  "space": { "section-y": "4rem", "gutter": ["1.25rem", "3rem", "5rem"] },
  "logo": {
    "mark": "The slate in the frame: a clapperboard inside the corner brackets of a cinema frame. One colour, no tile, no gradient. Brackets 2.2 stroke, clapper stripes 2",
    "wordmark": "PitchGen, Sora 700, same colour as the mark",
    "on light": "fg #0b1215",
    "on dark or teal": "white",
    "app icon": "white mark on a teal-950 rounded square (favicon, apple-icon)"
  }
}
