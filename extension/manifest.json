{
  "manifest_version": 3,
  "name": "Save to PitchGen",
  "version": "0.1.0",
  "description": "Right-click any frame on ShotDeck, Flim, Film-Grab or anywhere else and send it straight into a PitchGen pitch.",
  "permissions": ["contextMenus", "storage", "activeTab", "scripting", "notifications"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Save to PitchGen" },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
