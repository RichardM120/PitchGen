# Access
PITCHGEN_PASSWORD=            # shared viewer passcode
PITCHGEN_ADMIN_PASSWORD=      # Producer Studio passcode
PITCHGEN_SECRET=              # long random string; changing it signs everyone out

# Storage (set automatically by the Vercel Blob store)
BLOB_READ_WRITE_TOKEN=

# AI intake
ANTHROPIC_API_KEY=            # required for Generate from notes
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=               # optional, Whisper transcription for voice notes

# Mount path. "" once PitchGen has its own domain.
NEXT_PUBLIC_BASE_PATH=/pitchgen
